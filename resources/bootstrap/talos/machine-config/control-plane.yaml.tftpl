# tofu/talos/machine-config/control-plane.yaml.tftpl
#
# Generated with machine config contract v1.14 (see local.config_contract in
# config.tf). Kubernetes and network settings live in multi-document configs;
# only etcd stays in v1alpha1, which Talos 1.14 still accepts.

machine:
  type: controlplane

cluster:
  etcd:
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
---
# Static address on the single virtio NIC (ens18 on every VM); no DHCP because
# no DHCPv4Config document exists. Route without destination = default route.
apiVersion: v1alpha1
kind: LinkConfig
name: ens18
up: true
addresses:
  - address: ${ip}/${cidr}
routes:
  - gateway: ${gateway}
---
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: ${vip}
link: ens18
---
apiVersion: v1alpha1
kind: KubeletConfig
extraArgs:
  rotate-server-certificates: "true"
---
apiVersion: v1alpha1
kind: KubeNodeConfig
# The generated document already carries the control-plane role labels and
# the NoSchedule taint (formerly allowSchedulingOnControlPlanes: false).
labels:
  topology.kubernetes.io/region: ${cluster_name}
  topology.kubernetes.io/zone: ${node_name}
---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
extraArgs:
  bind-address: "0.0.0.0"
---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
extraArgs:
  bind-address: "0.0.0.0"
---
# Cilium replaces kube-proxy.
apiVersion: v1alpha1
kind: KubeProxyConfig
enabled: false
---
# Cilium is the CNI (installed by the cilium-bootstrap inline manifest, then
# managed by ArgoCD), so drop the generated Flannel config.
apiVersion: v1alpha1
kind: KubeFlannelCNIConfig
$patch: delete
---
# Keep /var mounted without nosuid/nodev, as before contract v1.14.
apiVersion: v1alpha1
kind: VolumeConfig
name: EPHEMERAL
mount:
  secure: false
---
apiVersion: v1alpha1
kind: SecurityProfileConfig
workloadIsolation: ${workload_isolation}
---
# Gateway API CRDs, standard channel only: since v1.5 the safe-upgrades
# ValidatingAdmissionPolicy rejects experimental CRDs on top of standard ones,
# which breaks `talosctl upgrade-k8s` manifest sync.
apiVersion: v1alpha1
kind: KubeExternalManifestConfig
name: gateway-api-gatewayclasses
url: https://raw.githubusercontent.com/kubernetes-sigs/gateway-api/${gateway_api_version}/config/crd/standard/gateway.networking.k8s.io_gatewayclasses.yaml
---
apiVersion: v1alpha1
kind: KubeExternalManifestConfig
name: gateway-api-gateways
url: https://raw.githubusercontent.com/kubernetes-sigs/gateway-api/${gateway_api_version}/config/crd/standard/gateway.networking.k8s.io_gateways.yaml
---
apiVersion: v1alpha1
kind: KubeExternalManifestConfig
name: gateway-api-httproutes
url: https://raw.githubusercontent.com/kubernetes-sigs/gateway-api/${gateway_api_version}/config/crd/standard/gateway.networking.k8s.io_httproutes.yaml
---
apiVersion: v1alpha1
kind: KubeExternalManifestConfig
name: gateway-api-referencegrants
url: https://raw.githubusercontent.com/kubernetes-sigs/gateway-api/${gateway_api_version}/config/crd/standard/gateway.networking.k8s.io_referencegrants.yaml
---
apiVersion: v1alpha1
kind: KubeExternalManifestConfig
name: gateway-api-grpcroutes
url: https://raw.githubusercontent.com/kubernetes-sigs/gateway-api/${gateway_api_version}/config/crd/standard/gateway.networking.k8s.io_grpcroutes.yaml
---
apiVersion: v1alpha1
kind: KubeExternalManifestConfig
name: gateway-api-tlsroutes
url: https://raw.githubusercontent.com/kubernetes-sigs/gateway-api/${gateway_api_version}/config/crd/standard/gateway.networking.k8s.io_tlsroutes.yaml
---
apiVersion: v1alpha1
kind: KubeExternalManifestConfig
name: metrics-server
url: https://github.com/kubernetes-sigs/metrics-server/releases/download/v0.8.1/components.yaml
---
apiVersion: v1alpha1
kind: KubeInlineManifestConfig
name: cilium-values
manifest: |
  ---
  apiVersion: v1
  kind: ConfigMap
  metadata:
    name: cilium-values
    namespace: kube-system
  data:
    values.yaml: |-
      ${indent(6, cilium_values)}
---
apiVersion: v1alpha1
kind: KubeInlineManifestConfig
name: cilium-bootstrap
manifest: |
  ${indent(2, cilium_install)}
---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: ${hostname}
auto: off
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
- address: 10.0.10.193
- address: 8.8.8.8
---
apiVersion: v1alpha1
kind: TimeSyncConfig
ntp:
  servers:
  - 0.pool.ntp.org
  - 1.pool.ntp.org
---
apiVersion: v1alpha1
kind: FilesystemTrimConfig
interval: 168h0m0s
